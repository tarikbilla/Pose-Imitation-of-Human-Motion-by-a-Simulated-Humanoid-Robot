  orientation 0.02860952101842819 -0.01070769781337589 0.9995333113581725 3.0934870340474974
  position 2.5989854619784194 -0.09875644362047671 0.29885285167521725
  follow "NAO"
}
Floor {
  size 20 20
  tileSize 1 1
}
